# JOOLA Customer Demo — environment variables.
# All variables MUST be prefixed with NEXT_PUBLIC_ — this app is a pure
# browser client that talks to Supabase (anon key) and the JOOLA AI API directly.
# Copy to .env.local and fill in values.

# Supabase (browser client + Realtime subscription for emails)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_or_anon_key

# Backend (Python FastAPI) — receives email + web form submissions
NEXT_PUBLIC_API_URL=http://localhost:3001

# Vapi Web SDK
# Public key from Vapi dashboard (NOT the secret API key)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Assistant ID — created via packages/vapi-assistant-config
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
