{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "uv sync --frozen --no-dev --no-install-project",
  "buildCommand": "python scripts/vercel_prepare.py",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,app/tests/**,Dockerfile,uv.lock}"
    }
  }
}
