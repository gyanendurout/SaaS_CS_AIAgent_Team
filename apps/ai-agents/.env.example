# JOOLA AI Agents service — environment variables
# Copy to ../../.env.local at the repo root (the service reads from there in dev)
# or set these in the Vercel project settings for deploy.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx          # service-role / secret key — bypasses RLS
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
POLICY_VERSION=1.0.0
# Shared knowledge memory (pgvector kb_chunks). static = off (original behaviour).
KNOWLEDGE_SOURCE=static
EMBEDDING_MODEL=text-embedding-3-small
# Live Shopify catalogue (price/sale/stock). off = disabled (original behaviour).
CATALOG_SOURCE=off
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=xxx
SHOPIFY_API_VERSION=2026-07
# Shared secret required on the paid tool endpoints when set (API sends it as
# X-Internal-Secret). Must equal the API's AI_AGENTS_SECRET.
AI_AGENTS_SECRET=
PORT=8000
LOG_LEVEL=INFO
