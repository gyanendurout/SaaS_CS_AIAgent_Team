# JOOLA AI Agents service — environment variables
# Copy to ../../.env.local at the repo root (the service reads from there in dev)
# or set these directly in Railway for deploy.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx          # service-role / secret key — bypasses RLS
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
POLICY_VERSION=1.0.0
PORT=8000
LOG_LEVEL=INFO
