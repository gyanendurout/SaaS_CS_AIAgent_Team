# JOOLA CS Command Dashboard — environment template
# Copy to ../../.env.local at project root (Vercel substitutes in prod).
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle.

# Supabase project (use the publishable / anon key, NOT the secret key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend API base URL (apps/api on Railway in prod; local dev defaults below)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Where this dashboard itself is reachable (used by relative redirects / shareable links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Policy version surfaced in the DecisionCard label
NEXT_PUBLIC_POLICY_VERSION=1.0.0
