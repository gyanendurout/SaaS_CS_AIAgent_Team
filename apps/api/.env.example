# ============================================================================
# JOOLA AI CS Warranty Management — apps/api environment variables
# ----------------------------------------------------------------------------
# Copy to repo root .env.local and fill in real values (this file mirrors the
# subset that the Fastify backend needs). Never commit real secrets.
# ============================================================================

# --- HTTP / runtime --------------------------------------------------------
PORT=3001
NODE_ENV=development

# --- Supabase (server-side, service role) ----------------------------------
# Bypasses RLS — control access in app logic only.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<paste>

# --- Vapi -----------------------------------------------------------------
# Private API key (assistant management). Webhook secret verifies inbound HMAC.
VAPI_API_KEY=<rotate-and-paste>
VAPI_WEBHOOK_SECRET=<rotate-and-paste>

# --- Python AI agents service ---------------------------------------------
# Where this API proxies eligibility evaluation + pipeline runs to.
PYTHON_AI_URL=http://localhost:8000

# --- Public URL where Vapi reaches this API (ngrok in dev, Railway in prod)
PUBLIC_BACKEND_URL=https://<your-ngrok-or-railway-host>

# --- Policy + CORS --------------------------------------------------------
POLICY_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
