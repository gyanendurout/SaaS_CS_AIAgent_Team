# ============================================================================
# JOOLA AI CS Warranty Management System — Environment Variables Template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
# Public URL for the Supabase project (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-url>
# Anonymous (publishable) key — safe to expose to browser, gated by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Server-side Supabase (api + ai-agents only — NEVER expose to browser)
SUPABASE_URL=<your-supabase-url>
SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Service role key bypasses RLS — keep server-side only
SUPABASE_SERVICE_ROLE_KEY=<rotate-and-paste>
# JWT secret used to verify Supabase-issued tokens (post-demo auth)
SUPABASE_JWT_SECRET=<rotate-and-paste>

# ----------------------------------------------------------------------------
# Database (Postgres via Supabase)
# ----------------------------------------------------------------------------
# Pooled connection string (use for app runtime queries)
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true
# Direct connection (use for migrations / Prisma push / one-off scripts)
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ----------------------------------------------------------------------------
# OpenAI (GPT-4o for reasoning, Whisper for STT, TTS for voice)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=<rotate-and-paste>
# Default model identifier for chat completions
OPENAI_MODEL=gpt-4o

# ----------------------------------------------------------------------------
# Vapi (browser voice agent)
# ----------------------------------------------------------------------------
# Public key — used by the browser SDK to start a call
NEXT_PUBLIC_VAPI_PUBLIC_KEY=<your-vapi-public-key>
# Assistant ID configured in Vapi dashboard
NEXT_PUBLIC_VAPI_ASSISTANT_ID=<your-vapi-assistant-id>
VAPI_ASSISTANT_ID=<your-vapi-assistant-id>
# Private key — server-side only (Vapi management API)
VAPI_API_KEY=<rotate-and-paste>
VAPI_PRIVATE_KEY=<rotate-and-paste>
# Shared secret used to verify Vapi webhook signatures
VAPI_WEBHOOK_SECRET=<rotate-and-paste>

# ----------------------------------------------------------------------------
# ngrok / public backend URL
# ----------------------------------------------------------------------------
# Public HTTPS URL where Vapi webhooks reach the Fastify API during local dev.
# In production, set this to the Railway-hosted api URL.
PUBLIC_BACKEND_URL=https://<your-ngrok-or-railway-host>
# Optional: ngrok auth token if you start the tunnel from a script
NGROK_AUTHTOKEN=<rotate-and-paste>

# ----------------------------------------------------------------------------
# App config
# ----------------------------------------------------------------------------
# Public URL the dashboard runs on (used for absolute links in emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL of the Fastify API (consumed by the dashboard)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Pre-seeded demo data + scripted happy-path toggles ("true" | "false")
DEMO_MODE=true
# Pinned warranty policy version evaluated by the deterministic rule engine
POLICY_VERSION=1.0.0
# Fastify port (Railway will override via $PORT)
PORT=4000
# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
